# ==============================================================================
# DataConform Frontend — Configurações de Ambiente & Checkout
# ==============================================================================

# URL base da API backend (Opcional — sob proxy Nginx/Vite usa /api)
# VITE_API_URL=https://api.dataconform.com.br

# E-mail institucional de suporte (NÃO preencher até o MX/Zoho Mail estar ativo e testado!)
VITE_SUPPORT_EMAIL=

# Fallback opcional de Payment Links estáticos (quando o backend já possui Stripe__ProPriceId,
# o modal utiliza automaticamente POST /api/workspaces/{id}/billing/checkout-session)
VITE_STRIPE_PRO_URL=
VITE_STRIPE_ENTERPRISE_URL=
