# ==============================================================================
# DataConform — Variáveis de Ambiente de Produção (Render / Docker / VPS)
# ==============================================================================
# IMPORTANTE: NUNCA comite chaves reais neste repositório. Configure diretamente
# no painel do provedor (Render Environment Variables / GitHub Actions Secrets).
# ==============================================================================

# Senha forte do PostgreSQL (quando rodando via docker-compose.prod.yml) ou DATABASE_URL (Neon/Render)
DB_PASSWORD=GERE_UMA_SENHA_FORTE_EXCLUSIVA_AQUI
# DATABASE_URL=postgresql://usuario:senha@ep-exemplo.us-east-1.aws.neon.tech/dataconform?sslmode=require

# Chave secreta exclusiva para assinatura JWT em Produção (OBRIGATÓRIO >= 64 caracteres aleatórios)
JWT_SECRET=GERE_COM_OPENSSL_RAND_BASE64_48_OU_RENDER_GENERATE_VALUE

# Chave administrativa para leitura de leads e chamados (GET /api/feedbacks via X-Admin-Key)
ADMIN_API_KEY=GERE_UMA_CHAVE_ADMINISTRATIVA_EXCLUSIVA_MIN_32_CHARS

# Origens permitidas no CORS de Produção
ALLOWED_ORIGINS=https://dataconform.com.br,https://www.dataconform.com.br

# Integração Stripe Live / Test (Checkout Sessions + Customer Portal + Webhooks)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# Canal de e-mail institucional verificado (deixe vazio enquanto o MX não estiver ativo!)
SUPPORT_EMAIL=
VITE_SUPPORT_EMAIL=

# Links estáticos de fallback do Stripe (opcional caso utilize Checkout Sessions dinâmicas via API)
VITE_STRIPE_PRO_URL=
VITE_STRIPE_ENTERPRISE_URL=
