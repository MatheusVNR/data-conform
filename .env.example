# ==============================================================================
# DataConform — Variáveis de Ambiente para Desenvolvimento Local
# ==============================================================================
# INSTRUÇÕES:
# 1. Copie este arquivo para ".env" na raiz do projeto:
#    Copy-Item .env.example .env
# 2. Substitua os valores de exemplo por suas configurações locais.
# 3. NUNCA envie o arquivo ".env" com credenciais reais para o controle de versão.
# ==============================================================================

# Banco de dados PostgreSQL local (docker-compose.yml)
POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=dataconform
POSTGRES_PORT=5432

# Stripe em Modo Teste (Opcional em dev — obtenha em https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRO_PRICE_ID=
STRIPE_ENTERPRISE_PRICE_ID=

# Chave administrativa para consulta de feedbacks/leads (GET /api/feedbacks com header X-Admin-Key)
ADMIN_API_KEY=dev-admin-key-minimo-16-caracteres

# E-mail de suporte público (somente preencher após MX/Zoho estar ativo e verificado!)
SUPPORT_EMAIL=
