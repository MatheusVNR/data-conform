# ==============================================================================
# DataConform — Variáveis de Ambiente para Desenvolvimento Local
# ==============================================================================
# INSTRUÇÕES:
# 1. Copie este arquivo para ".env" na raiz do projeto:
#    cp .env.example .env (ou no PowerShell: Copy-Item .env.example .env)
# 2. Substitua os valores de exemplo por suas configurações locais.
# 3. NUNCA envie o arquivo ".env" com credenciais para o controle de versão.
# ==============================================================================

# Aceite do Contrato de Licença do Usuário Final (EULA) do SQL Server (Y = Sim)
ACCEPT_EULA=Y

# Senha do administrador de sistema (SA) do SQL Server
# Requisitos do SQL Server: mínimo 8 caracteres, contendo letras maiúsculas,
# minúsculas, dígitos numéricos e símbolos especiais (ex: ! @ # $ %).
# Exemplo fictício e seguro:
MSSQL_SA_PASSWORD=YourStrong@Password123!

# Porta exposta na máquina host (localhost) para conexões ao SQL Server
MSSQL_PORT=1433
