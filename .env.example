# ==============================================================================
# DataConform — Variáveis de Ambiente para Desenvolvimento Local
# ==============================================================================
# INSTRUÇÕES:
# 1. Copie este arquivo para ".env" na raiz do projeto:
#    cp .env.example .env (ou no PowerShell: Copy-Item .env.example .env)
# 2. Substitua os valores de exemplo por suas configurações locais.
# 3. NUNCA envie o arquivo ".env" com credenciais para o controle de versão.
# ==============================================================================

# Usuário administrador do PostgreSQL
POSTGRES_USER=postgres

# Senha do usuário do PostgreSQL
POSTGRES_PASSWORD=postgres

# Nome do banco de dados principal
POSTGRES_DB=dataconform

# Porta exposta na máquina host (localhost) para conexões ao PostgreSQL
POSTGRES_PORT=5432
